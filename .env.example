# Copy to .env to run locally (`node index.js`). On ZeroTo, add the same variable in the
# deployment's Variables tab instead (Used by: Running app) and redeploy.
APP_NAME=zeroto-test-app

# Optional: a Postgres to try /db and /notes locally. On ZeroTo this is added for you when you link a
# managed database (Databases -> your database -> Linked apps), then redeploy.
# DATABASE_URL=postgresql://postgres:password@localhost:5432/app

# Optional: a ZeroTo bucket to try /storage and /files locally. On ZeroTo these are added for you when you link a bucket
# (Storage -> your bucket -> Linked app), then redeploy.
# STORAGE_URL=https://.../storage/api/...
# STORAGE_BUCKET=test-files
# STORAGE_KEY=zts_...
