# Example variables for testing ZeroTo environment variables. Fake values only — never put real
# secrets in this file. To use it: in ZeroTo, "Add from .env", paste a section, pick who uses it.
# (A .env file has no "scope"; you choose it in ZeroTo when you paste.)

# --- Running app — paste with "Used by: Running app" -------------------------------------------
# Shown in full at /env because the name starts with PUBLIC_
PUBLIC_GREETING=hello
# Mark as secret: /env shows only "set" and the length (12), never the value
DB_PASSWORD=s3cret-value
APP_NAME=zeroto-test-app

# --- Build only — paste with "Used by: Build only", mark as secret ---------------------------
# Visible at /build (present: true) but NOT at /env: the running app can't see it
BUILD_TOKEN=build-secret-123

# --- Build and running app — paste with "Used by: Build and running app" ----------------------
# Visible at both /build and /env
NPM_TOKEN=npm-token-xyz
